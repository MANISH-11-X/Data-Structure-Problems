#include<stdio.h>
#define max 10

int front = -1, rear = -1;
int deque[max];

void insert_front(){
    int n;
    printf("Enter element to insert :");
    scanf("%d", &n);

    if(front == 0 && rear == max-1 || front == rear + 1){
        printf("Deque is Full!");
        return;
    }

    if(front == -1){
        front = rear = 0;
    }
    else if(front == 0){
        front = max - 1;
    }
    else{
        front--;
    }
    deque[front] = n;
}

void insert_rear(){

    int n;
    printf("Enter element to insert :");
    scanf("%d", &n);

    if(front == 0 && rear == max-1 || front == rear + 1){
        printf("Deque is Full!");
        return;
    }

    if(front == -1){
        front = rear = 0;
    }
    else if(rear == max - 1){
        rear = 0;
    }
    else{
        rear++;
    }
    deque[rear] = n;

}

void delete_front(){

    if(front == -1){
        printf("Deque is empty!");
        return;
    }
    printf("Deleted element is :%d",deque[front]);

    if(front == rear){
        front = rear = -1;
    }
    else if(front == max - 1){
        front = 0;
    }
    else{
        front++;
    }
}

void delete_rear(){

    if(front == -1){
        printf("Deque is empty!");
        return;
    }
    printf("Deleted element is :%d",deque[rear]);

    if(front == rear){
        front = rear = -1;
    }
    else if(rear == 0){
        rear = max - 1;
    }
    else{
        rear--;
    }

}

void display(){
    if(front == -1){
        printf("Queue is empty");
        return;
    }
    int i = front;

    while(1){
        printf("%d\n",deque[i]);

        if(i == rear){
            break;
        }

        i = (i + 1) % max;
    }
}

int main(){
    int choice;

    while(1){
        printf("1.Insert Front\n");
        printf("2.Insert Rear\n");
        printf("3.Delete Front\n");
        printf("4.Delete Rear\n");
        printf("5.Display\n");
        printf("Enter above operation :");
        scanf("%d",&choice);

        switch(choice){
            case 1: insert_front();
            break;
            case 2: insert_rear();
            break;
            case 3: delete_front();
            break;
            case 4: delete_rear();
            break;
            case 5: display();
            break;
            default:
            printf("You entered wrong operation");
        }
    }
}
